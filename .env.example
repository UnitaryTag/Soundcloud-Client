# Copy to `.env` and fill in. `.env` is gitignored.
#
# Obtain credentials at https://soundcloud.com/you/apps
# NOTE: registration requires an Artist Pro subscription.
#
# The redirect URI you register there MUST be exactly:
#     http://127.0.0.1:8765/callback
# (or whatever port you set in SC_REDIRECT_PORT below). A mismatch here is the
# single most likely cause of a redirect_uri error during login.
#
# These are baked into the build as the app's DEFAULT credentials. Users can
# override them at runtime with their own (Settings -> credentials), which is
# how someone with their own Artist Pro subscription gets their own rate-limit
# quota instead of sharing yours.
#
# SECURITY: anything built into the bundle is extractable from the shipped app.
# Treat SC_CLIENT_SECRET as public if you distribute this. See README.

SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_PORT=8765
